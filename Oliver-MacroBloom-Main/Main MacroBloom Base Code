@dataclass(frozen=True)
class RunResult:
    before: Portfolio
    after: Portfolio
    before_env: float
    after_env: float
    before_risk: float
    after_risk: float
    turnover: float
    sector_drift_l1: float
    region_drift_l1: float
    top_changes: List[Tuple[str, float, float]]  # (ticker, w_before, w_after)

    def to_json(self) -> Dict[str, Any]:
        return {
            "before": self.before.weights,
            "after": self.after.weights,
            "metrics": {
                "before_env": self.before_env,
                "after_env": self.after_env,
                "before_risk_proxy": self.before_risk,
                "after_risk_proxy": self.after_risk,
                "turnover": self.turnover,
                "sector_drift_l1": self.sector_drift_l1,
                "region_drift_l1": self.region_drift_l1,
            },
            "top_changes": [
                {"ticker": t, "before": wb, "after": wa, "delta": wa - wb}
                for (t, wb, wa) in self.top_changes
            ],
        }


def summarize_changes(before: Portfolio, after: Portfolio, top_n: int = 12) -> List[Tuple[str, float, float]]:
    keys = set(before.weights) | set(after.weights)
    deltas = []
    for k in keys:
        wb = before.weights.get(k, 0.0)
        wa = after.weights.get(k, 0.0)
        deltas.append((abs(wa - wb), k, wb, wa))
    deltas.sort(reverse=True, key=lambda x: x[0])
    return [(k, wb, wa) for _, k, wb, wa in deltas[:top_n]]


def build_result(before: Portfolio, after: Portfolio, features: Dict[str, FeatureRow]) -> RunResult:
    before_n = before.normalized()
    after_n = after.normalized()

    before_env = portfolio_env_score(before_n.weights, features)
    after_env = portfolio_env_score(after_n.weights, features)

    before_risk = portfolio_risk_proxy(before_n.weights, features)
    after_risk = portfolio_risk_proxy(after_n.weights, features)

    turn = before_n.l1_turnover_to(after_n)

    sec_before = exposure_by_group(before_n.weights, features, lambda r: r.sector)
    sec_after = exposure_by_group(after_n.weights, features, lambda r: r.sector)
    reg_before = exposure_by_group(before_n.weights, features, lambda r: r.region)
    reg_after = exposure_by_group(after_n.weights, features, lambda r: r.region)

    sec_drift = l1_exposure_distance(sec_before, sec_after)
    reg_drift = l1_exposure_distance(reg_before, reg_after)

    changes = summarize_changes(before_n, after_n)

    return RunResult(
        before=before_n,
        after=after_n,
        before_env=before_env,
        after_env=after_env,
        before_risk=before_risk,
        after_risk=after_risk,
        turnover=turn,
        sector_drift_l1=sec_drift,
        region_drift_l1=reg_drift,
        top_changes=changes,
    )


def format_report(result: RunResult, features: Dict[str, FeatureRow]) -> str:
    lines: List[str] = []
    lines.append("Macrobloom Lab Report (Monolith)")
    lines.append("=" * 38)
    lines.append("")
    lines.append("Key Metrics")
    lines.append("-" * 11)
    lines.append(f"Environmental score: {result.before_env:.4f} -> {result.after_env:.4f}  (Δ = {result.after_env - result.before_env:+.4f})")
    lines.append(f"Risk proxy:         {result.before_risk:.4f} -> {result.after_risk:.4f}  (Δ = {result.after_risk - result.before_risk:+.4f})")
    lines.append(f"Turnover (L1):      {result.turnover:.4f}")
    lines.append(f"Sector drift (L1):  {result.sector_drift_l1:.4f}")
    lines.append(f"Region drift (L1):  {result.region_drift_l1:.4f}")
    lines.append("")
    lines.append("Top Weight Changes")
    lines.append("-" * 16)

    for t, wb, wa in result.top_changes:
        row = features.get(t)
        env = None if row is None else row.env_score
        envs = "n/a" if env is None else f"{env:.3f}"
        lines.append(f"{t:>6s}  {wb:>7.4f} -> {wa:>7.4f}   Δ={wa-wb:+.4f}   env={envs}")

    lines.append("")
    lines.append("Holdings (After, Top 20)")
    lines.append("-" * 22)
    top_after = sorted(result.after.weights.items(), key=lambda x: x[1], reverse=True)[:20]
    for t, w in top_after:
        row = features.get(t)
        meta = "" if row is None else f"{row.sector}/{row.region}"
        lines.append(f"{t:>6s}  {w:>7.4f}   {meta}")

    return "\n".join(lines)


# =============================================================================
# Orchestrator
# =============================================================================

@dataclass(frozen=True)
class RunConfig:
    provider: str = "mock"  # "mock" or "csv"
    csv_path: Optional[str] = None
    winsor_p: float = 0.03
    env_w_intensity: float = 1.0
    env_w_abs: float = 0.15
    top_k: int = 8
    sector_lock: bool = True
    region_lock: bool = True
    solver: str = "qp_like"  # "qp_like" or "greedy"
    max_iters: int = 1500
    step_size: float = 0.05
    max_turnover: float = 0.35
    exposure_tolerance: float = 0.06
    seed: int = 7
    log: bool = True


def run_pipeline(cfg: RunConfig, portfolio: Portfolio, universe_assets: List[Asset]) -> RunResult:
    logger = Log(enabled=cfg.log)

    logger.info("building feature table...")
    features = build_feature_table(
        universe_assets,
        winsor_p=cfg.winsor_p,
        env_w_intensity=cfg.env_w_intensity,
        env_w_abs=cfg.env_w_abs
    )

    portfolio_n = portfolio.normalized()
    logger.info("building candidate sets...")
    cset = build_candidate_sets(
        portfolio=portfolio_n,
        features=features,
        top_k=cfg.top_k,
        sector_lock=cfg.sector_lock,
        region_lock=cfg.region_lock,
        logger=logger
    )

    swap_universe = build_swap_universe(portfolio_n, cset)

    logger.info(f"swap universe size: {len(swap_universe.tickers)} (owned={len(swap_universe.owned)})")
    base_env = portfolio_env_score(portfolio_n.weights, features)
    base_risk = portfolio_risk_proxy(portfolio_n.weights, features)
    logger.info(f"baseline env={base_env:.4f} risk_proxy={base_risk:.4f}")

    after: Portfolio
    if cfg.solver == "greedy":
        after = greedy_swap(
            portfolio=portfolio_n,
            universe=swap_universe,
            features=features,
            max_turnover=cfg.max_turnover,
            exposure_tol=cfg.exposure_tolerance,
            logger=logger
        )
    else:
        solver_cfg = SolverConfig(
            max_iters=cfg.max_iters,
            step_size=cfg.step_size,
            max_turnover=cfg.max_turnover,
            exposure_tolerance=cfg.exposure_tolerance,
        )
        after = _optimize_projected_gradient(
            universe=swap_universe,
            features=features,
            start=portfolio_n,
            cfg=solver_cfg,
            logger=logger
        )

        # if optimization fails to improve meaningfully, optionally fall back to greedy
        if cfg.solver != "greedy":
            before_env = portfolio_env_score(portfolio_n.weights, features)
            after_env = portfolio_env_score(after.weights, features)
            if after_env >= before_env - 1e-6:
                logger.warn("optimizer did not improve env score. falling back to greedy...")
                after = greedy_swap(
                    portfolio=portfolio_n,
                    universe=swap_universe,
                    features=features,
                    max_turnover=cfg.max_turnover,
                    exposure_tol=cfg.exposure_tolerance,
                    logger=logger
                )

    result = build_result(portfolio_n, after, features)
    return result


# =============================================================================
# Demo portfolio generator (so you can run it without data)
# =============================================================================

def make_demo_portfolio(assets: Sequence[Asset], seed: int = 7, n_holdings: int = 10) -> Portfolio:
    rng = random.Random(seed)
    tickers = [a.ticker for a in assets]
    picks = rng.sample(tickers, k=min(n_holdings, len(tickers)))
    raw = [rng.random() for _ in picks]
    s = sum(raw)
    weights = {t: r / s for t, r in zip(picks, raw)}
    return Portfolio(weights).normalized()


