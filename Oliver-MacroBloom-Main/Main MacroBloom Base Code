def _sanity_check() -> None:
    # quick invariants: simplex, exposures not blowing up, etc.
    assets = MockAssetProvider(n=60, seed=3).load()
    features = build_feature_table(assets)
    p0 = make_demo_portfolio(assets, seed=3, n_holdings=10)
    cset = build_candidate_sets(p0, features, top_k=6, sector_lock=True, region_lock=True, logger=Log(enabled=False))
    uni = build_swap_universe(p0, cset)

    cfg = RunConfig(provider="mock", log=False)
    res = run_pipeline(cfg, p0, assets)

    s_after = sum(res.after.weights.values())
    if abs(s_after - 1.0) > 1e-6:
        raise AssertionError("after weights not normalized")

    # basic improvement expectation (not guaranteed, but usually)
    # don't hard-fail, just warn if no improvement
    if res.after_env > res.before_env + 1e-9:
        print("WARN: sanity check saw env score worsen (can happen rarely).", file=sys.stderr)


if __name__ == "__main__":
    # uncomment if you want a quick sanity check on every run
    # _sanity_check()
    raise SystemExit(main())
