class AssetProvider:
    def load(self) -> List[Asset]:
        raise NotImplementedError


class CsvAssetProvider(AssetProvider):
    """
    CSV columns expected:
      ticker,sector,region,beta,mktcap,volatility,co2_tons,revenue_usd
    """
    def __init__(self, path: str) -> None:
        self.path = path

    def load(self) -> List[Asset]:
        if not os.path.exists(self.path):
            raise FileNotFoundError(self.path)

        assets: List[Asset] = []
        with open(self.path, "r", encoding="utf-8") as f:
            header = f.readline().strip().split(",")
            cols = {name.strip(): i for i, name in enumerate(header)}
            required = ["ticker","sector","region","beta","mktcap","volatility","co2_tons","revenue_usd"]
            missing = [r for r in required if r not in cols]
            if missing:
                raise ValueError(f"Missing required columns: {missing}")

            for line_no, line in enumerate(f, start=2):
                if not line.strip():
                    continue
                parts = [p.strip() for p in line.strip().split(",")]
                try:
                    a = Asset(
                        ticker=parts[cols["ticker"]].upper(),
                        sector=parts[cols["sector"]],
                        region=parts[cols["region"]],
                        beta=float(parts[cols["beta"]]),
                        mktcap=float(parts[cols["mktcap"]]),
                        volatility=float(parts[cols["volatility"]]),
                        co2_tons=float(parts[cols["co2_tons"]]),
                        revenue_usd=float(parts[cols["revenue_usd"]]),
                    )
                    assets.append(a)
                except Exception as e:
                    raise ValueError(f"CSV parse error at line {line_no}: {e}") from e

        ensure_unique_tickers(assets)
        return assets


class MockAssetProvider(AssetProvider):
    """
    Generates a pseudo-universe with semi-realistic correlations:
      - Sectors and regions define rough beta/volatility tendencies
      - CO2 intensity roughly depends on sector
      - Revenue scales with mktcap but noisy
    """
    SECTORS = [
        "Technology","Industrials","Financials","Energy","Utilities","Consumer","Healthcare","Materials","RealEstate"
    ]
    REGIONS = ["NA","EU","APAC"]

    def __init__(self, n: int = 80, seed: int = 7, cache: Optional[DiskCache] = None) -> None:
        self.n = n
        self.seed = seed
        self.cache = cache or DiskCache(ttl_seconds=24 * 3600)

    def load(self) -> List[Asset]:
        key = f"mock_provider:n={self.n}:seed={self.seed}"
        raw = self.cache.memoize(key, self._generate_raw)
        assets = [Asset(**a) for a in raw]
        ensure_unique_tickers(assets)
        return assets

    def _generate_raw(self) -> List[Dict[str, Any]]:
        rng = random.Random(self.seed)

        # sector CO2 baselines (tons / revenue unit)
        sector_intensity = {
            "Technology": 0.25,
            "Financials": 0.15,
            "Healthcare": 0.20,
            "Consumer": 0.35,
            "Industrials": 0.75,
            "Materials": 1.25,
            "Energy": 2.10,
            "Utilities": 1.60,
            "RealEstate": 0.55,
        }

        out: List[Dict[str, Any]] = []
        for i in range(self.n):
            sector = rng.choice(self.SECTORS)
            region = rng.choice(self.REGIONS)

            # mktcap lognormal-ish
            mktcap = math.exp(rng.gauss(23.0, 1.2))  # big numbers (USD)
            # base beta by sector/region with noise
            base_beta = {
                "Technology": 1.15,
                "Financials": 1.10,
                "Healthcare": 0.95,
                "Consumer": 1.00,
                "Industrials": 1.05,
                "Materials": 1.10,
                "Energy": 1.20,
                "Utilities": 0.75,
                "RealEstate": 0.90,
            }[sector]
            region_adjust = {"NA": 0.02, "EU": -0.01, "APAC": 0.00}[region]
            beta = max(0.3, base_beta + region_adjust + rng.gauss(0, 0.12))

            # volatility correlated with beta and region noise
            vol = max(0.05, 0.18 + 0.10 * (beta - 1.0) + rng.gauss(0, 0.05))

            # revenue scales with mktcap but noisy
            revenue = max(1.0, mktcap / math.exp(rng.gauss(2.8, 0.6)))

            # intensity baseline by sector with noise, then absolute co2 = intensity * revenue
            intensity = max(0.01, sector_intensity[sector] * math.exp(rng.gauss(0, 0.35)))
            co2_tons = max(0.0, intensity * revenue)

            ticker = f"MB{i:03d}"
            out.append({
                "ticker": ticker,
                "sector": sector,
                "region": region,
                "beta": float(beta),
                "mktcap": float(mktcap),
                "volatility": float(vol),
                "co2_tons": float(co2_tons),
                "revenue_usd": float(revenue),
            })

        return out


# =============================================================================
# Statistics helpers: winsorize and robust scaling
# =============================================================================

def winsorize(values: List[float], p: float = 0.03) -> List[float]:
    """
    Clip tails at p and 1-p quantiles. Pure python (no numpy).
    """
    if not values:
        return []
    if p <= 0:
        return values[:]
    xs = sorted(values)
    n = len(xs)
    lo_i = int(math.floor(p * (n - 1)))
    hi_i = int(math.ceil((1.0 - p) * (n - 1)))
    lo = xs[max(0, min(n - 1, lo_i))]
    hi = xs[max(0, min(n - 1, hi_i))]
    return [min(max(x, lo), hi) for x in values]


def median(values: List[float]) -> float:
    if not values:
        raise ValueError("median of empty list")
    xs = sorted(values)
    n = len(xs)
    mid = n // 2
    if n % 2 == 1:
        return xs[mid]
    return 0.5 * (xs[mid - 1] + xs[mid])


def mad(values: List[float]) -> float:
    """
    Median Absolute Deviation
    """
    m = median(values)
    dev = [abs(x - m) for x in values]
    return median(dev)


def robust_zscore(values: List[float], eps: float = 1e-9) -> List[float]:
    """
    Robust scaling using median and MAD.
    """
    m = median(values)
    s = mad(values)
    if s < eps:
        s = eps
    return [(x - m) / (1.4826 * s) for x in values]


# =============================================================================
# Feature engineering: "factor space" and environmental score
# =============================================================================

@dataclass(frozen=True)
class FeatureRow:
    ticker: str
    sector: str
    region: str
    # numeric features
    beta_z: float
    vol_z: float
    log_mktcap_z: float
    env_intensity_z: float
    abs_co2_z: float
    # combined env score (lower better)
    env_score: float


def build_feature_table(
    assets: Sequence[Asset],
    winsor_p: float = 0.03,
    env_w_intensity: float = 1.0,
    env_w_abs: float = 0.15
) -> Dict[str, FeatureRow]:
    """
    Create normalized features and environmental score for each asset.
    """
    tickers = [a.ticker for a in assets]
    betas = [a.beta for a in assets]
    vols = [a.volatility for a in assets]
    log_caps = [math.log(max(a.mktcap, 1.0)) for a in assets]
    env_int = [a.co2_intensity for a in assets]
    abs_co2 = [a.co2_tons for a in assets]

    # winsorize then robust z
    betas_w = winsorize(betas, winsor_p)
    vols_w = winsorize(vols, winsor_p)
    log_caps_w = winsorize(log_caps, winsor_p)
    env_int_w = winsorize(env_int, winsor_p)
    abs_co2_w = winsorize(abs_co2, winsor_p)

    beta_z = robust_zscore(betas_w)
    vol_z = robust_zscore(vols_w)
    cap_z = robust_zscore(log_caps_w)
    envint_z = robust_zscore(env_int_w)
    absco2_z = robust_zscore(abs_co2_w)

    # env score: weighted combination (lower is better)
    # Use a softplus-ish to penalize extremely high intensity more smoothly
    def softplus(x: float) -> float:
        # stable softplus
        if x > 30:
            return x
        return math.log1p(math.exp(x))

    rows: Dict[str, FeatureRow] = {}
    for i, a in enumerate(assets):
        score = env_w_intensity * softplus(envint_z[i]) + env_w_abs * softplus(absco2_z[i])
        rows[tickers[i]] = FeatureRow(
            ticker=a.ticker,
            sector=a.sector,
            region=a.region,
            beta_z=beta_z[i],
            vol_z=vol_z[i],
            log_mktcap_z=cap_z[i],
            env_intensity_z=envint_z[i],
            abs_co2_z=absco2_z[i],
            env_score=float(score)
        )

    return rows


# =============================================================================
# Similarity matching + candidate generation
# =============================================================================

@dataclass(frozen=True)
class CandidateSet:
    """
    For each owned ticker, a list of candidate replacement tickers.
    """
    candidates: Dict[str, List[str]]  # owned -> candidate tickers


def _euclid(a: Tuple[float, ...], b: Tuple[float, ...]) -> float:
    s = 0.0
    for x, y in zip(a, b):
        d = x - y
        s += d * d
    return math.sqrt(s)


def build_candidate_sets(
    portfolio: Portfolio,
    features: Dict[str, FeatureRow],
    top_k: int = 8,
    sector_lock: bool = True,
    region_lock: bool = True,
    logger: Optional[Log] = None
) -> CandidateSet:
    """
    For each ticker in the portfolio, find top-k "similar" tickers in the universe.
    Similarity is in a factor space (beta, vol, log_mktcap).
    Optionally lock sector/region so candidates match.
    """
    logger = logger or Log(enabled=False)

    all_tickers = list(features.keys())
    owned = [t for t in portfolio.support() if t in features]
    missing = [t for t in portfolio.support() if t not in features]
    if missing:
        logger.warn(f"{len(missing)} tickers not found in universe and will be ignored: {missing[:5]}")

    cand: Dict[str, List[str]] = {}
    for t in owned:
        ft = features[t]
        base_vec = (ft.beta_z, ft.vol_z, ft.log_mktcap_z)

        scored: List[Tuple[float, str]] = []
        for u in all_tickers:
            if u == t:
                continue
            fu = features[u]
            if sector_lock and fu.sector != ft.sector:
                continue
            if region_lock and fu.region != ft.region:
                continue

            u_vec = (fu.beta_z, fu.vol_z, fu.log_mktcap_z)
            dist = _euclid(base_vec, u_vec)

            # "prefer" lower env score as secondary tie-breaker
            # small penalty so distance is still primary
            dist2 = dist + 0.03 * max(0.0, fu.env_score)
            scored.append((dist2, u))

        scored.sort(key=lambda x: x[0])
        top = [u for _, u in scored[:top_k]]

        # Ensure we at least have something; if empty, relax locks
        if not top:
            logger.warn(f"No candidates for {t} under locks. Relaxing constraints for this ticker.")
            scored2: List[Tuple[float, str]] = []
            for u in all_tickers:
                if u == t:
                    continue
                fu = features[u]
                u_vec = (fu.beta_z, fu.vol_z, fu.log_mktcap_z)
                dist = _euclid(base_vec, u_vec)
                dist2 = dist + 0.03 * max(0.0, fu.env_score)
                scored2.append((dist2, u))
            scored2.sort(key=lambda x: x[0])
            top = [u for _, u in scored2[:top_k]]

        cand[t] = top

    return CandidateSet(candidates=cand)


# =============================================================================
# Exposure computations (sector + region) and a toy "risk proxy"
# =============================================================================

def exposure_by_group(
    weights: Dict[str, float],
    features: Dict[str, FeatureRow],
    group_fn: Callable[[FeatureRow], str]
) -> Dict[str, float]:
    exp: Dict[str, float] = {}
    for t, w in weights.items():
        if w <= 0:
            continue
        row = features.get(t)
        if row is None:
            continue
        g = group_fn(row)
        exp[g] = exp.get(g, 0.0) + w
    return exp


def l1_exposure_distance(a: Dict[str, float], b: Dict[str, float]) -> float:
    keys = set(a) | set(b)
    s = 0.0
    for k in keys:
        s += abs(a.get(k, 0.0) - b.get(k, 0.0))
    return s


def portfolio_env_score(weights: Dict[str, float], features: Dict[str, FeatureRow]) -> float:
    s = 0.0
    for t, w in weights.items():
        if w <= 0:
            continue
        row = features.get(t)
        if row is None:
            continue
        s += w * row.env_score
    return s


def portfolio_risk_proxy(weights: Dict[str, float], features: Dict[str, FeatureRow]) -> float:
    """
    Not real risk. A simple proxy:
      risk ~ sum w * (vol_z^2 + 0.25*beta_z^2)
    """
    s = 0.0
    for t, w in weights.items():
        if w <= 0:
            continue
        row = features.get(t)
        if row is None:
            continue
        s += w * (row.vol_z * row.vol_z + 0.25 * row.beta_z * row.beta_z)
    return s


# =============================================================================
# Candidate-based feasible universe creation
# =============================================================================

@dataclass(frozen=True)
class SwapUniverse:
    """
    Universe of tickers allowed for the optimizer:
      - original holdings
      - candidates for each holding
    """
    tickers: List[str]
    owned: List[str]
    candidates: CandidateSet

    def index(self) -> Dict[str, int]:
        return {t: i for i, t in enumerate(self.tickers)}


def build_swap_universe(portfolio: Portfolio, cset: CandidateSet) -> SwapUniverse:
    owned = [t for t in portfolio.support() if t in cset.candidates]
    allowed = set(owned)
    for t in owned:
        for u in cset.candidates[t]:
            allowed.add(u)
    tickers = sorted(allowed)
    return SwapUniverse(tickers=tickers, owned=owned, candidates=cset)


# =============================================================================
# Optimization: projected gradient with penalties (no numpy)
# =============================================================================

@dataclass
class SolverConfig:
    max_iters: int = 1500
    step_size: float = 0.05
    max_turnover: float = 0.35
    exposure_tolerance: float = 0.06
    penalty_exposure: float = 35.0
    penalty_turnover: float = 50.0
    penalty_neg: float = 80.0
    penalty_sum: float = 150.0
    greedy_fallback: bool = True


def _soft_abs(x: float, eps: float = 1e-6) -> float:
    return math.sqrt(x * x + eps)


def _project_simplex(v: List[float]) -> List[float]:
    """
    Project onto simplex {x>=0, sum x = 1}. O(n log n) algorithm.
    """
    n = len(v)
    if n == 0:
        return []
    u = sorted(v, reverse=True)
    cssv = 0.0
    rho = -1
    theta = 0.0
    for i in range(n):
        cssv += u[i]
        t = (cssv - 1.0) / (i + 1)
        if u[i] - t > 0:
            rho = i
            theta = t
    if rho == -1:
        # fallback: uniform
        return [1.0 / n] * n
    theta = (sum(u[:rho + 1]) - 1.0) / (rho + 1)
    return [max(x - theta, 0.0) for x in v]


def _weights_to_vec(tickers: List[str], w: Dict[str, float]) -> List[float]:
    return [float(w.get(t, 0.0)) for t in tickers]


def _vec_to_weights(tickers: List[str], v: List[float]) -> Dict[str, float]:
    return {t: float(max(0.0, v[i])) for i, t in enumerate(tickers)}


def _grad_env(v: List[float], tickers: List[str], features: Dict[str, FeatureRow]) -> List[float]:
    g = [0.0] * len(v)
    for i, t in enumerate(tickers):
        row = features.get(t)
        g[i] = 0.0 if row is None else row.env_score
    return g


def _exposure_vec(
    v: List[float],
    tickers: List[str],
    features: Dict[str, FeatureRow],
    group_fn: Callable[[FeatureRow], str]
) -> Dict[str, float]:
    exp: Dict[str, float] = {}
    for i, t in enumerate(tickers):
        w = v[i]
        if w <= 0:
            continue
        row = features.get(t)
        if row is None:
            continue
        g = group_fn(row)
        exp[g] = exp.get(g, 0.0) + w
    return exp


def _penalty_exposure_and_grad(
    v: List[float],
    tickers: List[str],
    features: Dict[str, FeatureRow],
    target_sector: Dict[str, float],
    target_region: Dict[str, float],
    tol: float,
    penalty: float
) -> Tuple[float, List[float]]:
    """
    Penalize exposure drift beyond tolerance using smooth absolute.
    Returns (penalty_value, gradient)
    """
    grad = [0.0] * len(v)
    val = 0.0

    # sector
    sec_now = _exposure_vec(v, tickers, features, lambda r: r.sector)
    reg_now = _exposure_vec(v, tickers, features, lambda r: r.region)

    def apply_group(now: Dict[str, float], target: Dict[str, float], group_fn: Callable[[FeatureRow], str]) -> None:
        nonlocal val, grad
        keys = set(now) | set(target)
        for k in keys:
            diff = now.get(k, 0.0) - target.get(k, 0.0)
            ad = _soft_abs(diff)
            # only penalize if outside tolerance
            if abs(diff) <= tol:
                continue
            # hinge-like: (|diff|-tol)^2
            hinge = abs(diff) - tol
            val += penalty * (hinge * hinge)

            # grad: 2*penalty*hinge * d(|diff|)/dv
            # d(|diff|) ~ diff/|diff|, smoothed by _soft_abs
            sign = diff / ad
            coeff = 2.0 * penalty * hinge * sign

            for i, t in enumerate(tickers):
                row = features.get(t)
                if row is None:
                    continue
                if group_fn(row) == k:
                    grad[i] += coeff  # because exposure is sum of weights in group

    apply_group(sec_now, target_sector, lambda r: r.sector)
    apply_group(reg_now, target_region, lambda r: r.region)

    return val, grad


def _penalty_turnover_and_grad(
    v: List[float],
    v0: List[float],
    max_turnover: float,
    penalty: float
) -> Tuple[float, List[float]]:
    """
    turnover = 0.5*sum |v - v0|
    Penalize beyond max_turnover with smooth abs.
    """
    grad = [0.0] * len(v)
    diffs = [v[i] - v0[i] for i in range(len(v))]
    # smooth abs
    abs_sum = 0.0
    sm = [_soft_abs(d) for d in diffs]
    abs_sum = sum(sm)
    turnover = 0.5 * abs_sum

    if turnover <= max_turnover:
        return 0.0, grad

    hinge = turnover - max_turnover
    val = penalty * hinge * hinge

    # gradient:
    # turnover = 0.5 * sum soft_abs(d_i)
    # d turnover / d v_i = 0.5 * d_i / soft_abs(d_i)
    for i, d in enumerate(diffs):
        grad[i] = 2.0 * penalty * hinge * (0.5 * (d / sm[i]))

    return val, grad


def _penalty_sum_and_grad(v: List[float], penalty: float) -> Tuple[float, List[float]]:
    """
    enforce sum(v)=1 using quadratic penalty
    """
    s = sum(v)
    diff = s - 1.0
    val = penalty * diff * diff
    grad = [2.0 * penalty * diff] * len(v)
    return val, grad


def _optimize_projected_gradient(
    universe: SwapUniverse,
    features: Dict[str, FeatureRow],
    start: Portfolio,
    cfg: SolverConfig,
    logger: Log
) -> Portfolio:
    tickers = universe.tickers
    v0 = _weights_to_vec(tickers, start.weights)
    v = v0[:]

    # normalize start onto simplex
    v = _project_simplex(v)

    # targets
    target_sector = exposure_by_group(start.weights, features, lambda r: r.sector)
    target_region = exposure_by_group(start.weights, features, lambda r: r.region)

    best_v = v[:]
    best_obj = float("inf")

    for it in range(cfg.max_iters):
        # base objective gradient = env score
        g_env = _grad_env(v, tickers, features)
        obj_env = sum(v[i] * g_env[i] for i in range(len(v)))

        # penalties
        pen_exp, g_exp = _penalty_exposure_and_grad(
            v, tickers, features,
            target_sector=target_sector,
            target_region=target_region,
            tol=cfg.exposure_tolerance,
            penalty=cfg.penalty_exposure
        )
        pen_to, g_to = _penalty_turnover_and_grad(
            v, v0,
            max_turnover=cfg.max_turnover,
            penalty=cfg.penalty_turnover
        )
        pen_sum, g_sum = _penalty_sum_and_grad(v, cfg.penalty_sum)

        # combine
        obj = obj_env + pen_exp + pen_to + pen_sum
        g = [g_env[i] + g_exp[i] + g_to[i] + g_sum[i] for i in range(len(v))]

        # track best
        if obj < best_obj:
            best_obj = obj
            best_v = v[:]

        # gradient step then project
        step = cfg.step_size / math.sqrt(1.0 + it * 0.01)  # mild decay
        v = [v[i] - step * g[i] for i in range(len(v))]
        v = _project_simplex(v)

        # early stop if stable
        if it % 150 == 0 and it > 0:
            # measure drift
            drift = sum(abs(v[i] - best_v[i]) for i in range(len(v)))
            logger.info(f"iter={it} obj={obj:.4f} env={obj_env:.4f} pen(exp/to/sum)=({pen_exp:.3f}/{pen_to:.3f}/{pen_sum:.3f}) drift={drift:.4f}")
            if drift < 1e-4:
                break

    out = Portfolio(_vec_to_weights(tickers, best_v)).normalized()
    return out


# =============================================================================
# Greedy fallback: swap within candidate sets
# =============================================================================

def greedy_swap(
    portfolio: Portfolio,
    universe: SwapUniverse,
    features: Dict[str, FeatureRow],
    max_turnover: float,
    exposure_tol: float,
    logger: Log
) -> Portfolio:
    """
    Greedy:
    - For each owned ticker, try swapping part of its weight into best candidate
      that reduces env score while keeping exposures within tolerance and turnover limit.
    - Iterate multiple passes until no improvement.
    """
    p = portfolio.normalized()
    target_sector = exposure_by_group(p.weights, features, lambda r: r.sector)
    target_region = exposure_by_group(p.weights, features, lambda r: r.region)

    def exposure_ok(w: Dict[str, float]) -> bool:
        s = exposure_by_group(w, features, lambda r: r.sector)
        r = exposure_by_group(w, features, lambda r: r.region)
        return (l1_exposure_distance(s, target_sector) <= 2.0 * exposure_tol + 1e-9) and \
               (l1_exposure_distance(r, target_region) <= 2.0 * exposure_tol + 1e-9)

    base_score = portfolio_env_score(p.weights, features)
    logger.info(f"greedy: starting env score={base_score:.4f}")

    for pass_i in range(25):
        improved = False

        for t in list(p.support()):
            if t not in universe.candidates.candidates:
                continue
            w_t = p.weights.get(t, 0.0)
            if w_t <= 1e-8:
                continue

            current_row = features.get(t)
            if current_row is None:
                continue

            # allocate a fraction to swap
            chunk = min(0.06, 0.5 * w_t)  # small chunk swap
            best_candidate = None
            best_delta = 0.0

            for u in universe.candidates.candidates[t]:
                row_u = features.get(u)
                if row_u is None:
                    continue
                # only consider candidates with better env
                if row_u.env_score >= current_row.env_score:
                    continue

                trial = dict(p.weights)
                trial[t] = max(0.0, trial.get(t, 0.0) - chunk)
                trial[u] = trial.get(u, 0.0) + chunk

                # normalize
                ssum = sum(trial.values())
                if ssum <= 0:
                    continue
                trial = {k: v / ssum for k, v in trial.items()}

                # constraints
                turn = p.l1_turnover_to(Portfolio(trial))
                if turn > max_turnover:
                    continue
                if not exposure_ok(trial):
                    continue

                delta = portfolio_env_score(p.weights, features) - portfolio_env_score(trial, features)
                if delta > best_delta:
                    best_delta = delta
                    best_candidate = u

            if best_candidate is not None and best_delta > 1e-8:
                # apply
                trial = dict(p.weights)
                trial[t] = max(0.0, trial.get(t, 0.0) - chunk)
                trial[best_candidate] = trial.get(best_candidate, 0.0) + chunk
                # normalize
                ssum = sum(trial.values())
                trial = {k: v / ssum for k, v in trial.items()}
                p = Portfolio(trial)
                improved = True

        new_score = portfolio_env_score(p.weights, features)
        logger.info(f"greedy: pass={pass_i} env score={new_score:.4f}")

        if not improved or abs(base_score - new_score) < 1e-7:
            break
        base_score = new_score

    return p.normalized()


