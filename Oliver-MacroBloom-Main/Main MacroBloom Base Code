def parse_portfolio_spec(spec: str) -> Dict[str, float]:
    """
    Parse: "AAPL:0.2,MSFT:0.3" -> dict
    """
    out: Dict[str, float] = {}
    if not spec.strip():
        raise ValueError("Empty portfolio spec.")
    for part in [p.strip() for p in spec.split(",") if p.strip()]:
        if ":" not in part:
            raise ValueError(f"Bad entry: {part}")
        t, w = part.split(":", 1)
        t = t.strip().upper()
        wv = float(w.strip())
        if wv < 0:
            raise ValueError(f"Negative weight: {t}")
        out[t] = out.get(t, 0.0) + wv
    if not out:
        raise ValueError("No valid weights parsed.")
    return out


def ensure_unique_tickers(assets: Sequence[Asset]) -> None:
    seen = set()
    for a in assets:
        if a.ticker in seen:
            raise ValueError(f"Duplicate ticker in assets: {a.ticker}")
        seen.add(a.ticker)


