class Log:
    def __init__(self, name: str = "macrobloom", enabled: bool = True) -> None:
        self.name = name
        self.enabled = enabled

    def _emit(self, level: str, msg: str) -> None:
        if not self.enabled:
            return
        ts = time.strftime("%H:%M:%S")
        print(f"[{ts}] {self.name} {level}: {msg}", file=sys.stderr)

    def info(self, msg: str) -> None:
        self._emit("INFO", msg)

    def warn(self, msg: str) -> None:
        self._emit("WARN", msg)

    def error(self, msg: str) -> None:
        self._emit("ERROR", msg)


# =============================================================================
# Utilities: Disk cache (to look serious; used for mock "provider" output)
# =============================================================================

@dataclass
class DiskCache:
    root: str = ".macrobloom_cache"
    ttl_seconds: int = 3600

    def __post_init__(self) -> None:
        os.makedirs(self.root, exist_ok=True)

    def _path(self, key: str) -> str:
        h = hashlib.sha256(key.encode("utf-8")).hexdigest()
        return os.path.join(self.root, f"{h}.json")

    def get(self, key: str) -> Optional[Any]:
        p = self._path(key)
        if not os.path.exists(p):
            return None
        try:
            with open(p, "r", encoding="utf-8") as f:
                blob = json.load(f)
            if time.time() - float(blob["time"]) > self.ttl_seconds:
                return None
            return blob["value"]
        except Exception:
            return None

    def set(self, key: str, value: Any) -> None:
        p = self._path(key)
        blob = {"time": time.time(), "value": value}
        with open(p, "w", encoding="utf-8") as f:
            json.dump(blob, f, indent=2)

    def memoize(self, key: str, fn: Callable[[], Any]) -> Any:
        hit = self.get(key)
        if hit is not None:
            return hit
        val = fn()
        self.set(key, val)
        return val


# =============================================================================
# Domain models
# =============================================================================

@dataclass(frozen=True)
class Asset:
    ticker: str
    sector: str
    region: str
    beta: float
    mktcap: float
    volatility: float
    co2_tons: float
    revenue_usd: float

    @property
    def co2_intensity(self) -> float:
        # Tons CO2 per USD of revenue. If revenue is tiny, cap denominator.
        denom = max(self.revenue_usd, 1.0)
        return self.co2_tons / denom

    def to_dict(self) -> Dict[str, Any]:
        return dataclasses.asdict(self)


@dataclass(frozen=True)
class Portfolio:
    weights: Dict[str, float]  # ticker -> weight

    def normalized(self) -> "Portfolio":
        s = sum(max(w, 0.0) for w in self.weights.values())
        if s <= 0:
            raise ValueError("Portfolio weights sum to <= 0.")
        return Portfolio({t: max(w, 0.0) / s for t, w in self.weights.items()})

    def support(self) -> List[str]:
        return [t for t, w in self.weights.items() if w > 0]

    def l1_turnover_to(self, other: "Portfolio") -> float:
        # L1 turnover = 0.5*sum |w_new - w_old|
        keys = set(self.weights) | set(other.weights)
        s = 0.0
        for k in keys:
            s += abs(self.weights.get(k, 0.0) - other.weights.get(k, 0.0))
        return 0.5 * s


# =============================================================================
# Validation + parsing
