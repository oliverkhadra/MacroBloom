def _load_assets_from_cfg(cfg: RunConfig) -> List[Asset]:
    if cfg.provider == "csv":
        if not cfg.csv_path:
            raise ValueError("csv_path required when provider=csv")
        return CsvAssetProvider(cfg.csv_path).load()

    # default mock
    provider = MockAssetProvider(n=80, seed=cfg.seed)
    return provider.load()


def cli_demo(args: argparse.Namespace) -> int:
    cfg = RunConfig(
        provider="mock",
        winsor_p=args.winsor_p,
        env_w_intensity=args.env_w_intensity,
        env_w_abs=args.env_w_abs,
        top_k=args.top_k,
        sector_lock=not args.no_sector_lock,
        region_lock=not args.no_region_lock,
        solver=args.solver,
        max_iters=args.max_iters,
        step_size=args.step_size,
        max_turnover=args.max_turnover,
        exposure_tolerance=args.exposure_tolerance,
        seed=args.seed,
        log=not args.quiet
    )

    assets = MockAssetProvider(n=args.n, seed=args.seed).load()
    portfolio = make_demo_portfolio(assets, seed=args.seed, n_holdings=args.holdings)

    result = run_pipeline(cfg, portfolio, assets)
    features = build_feature_table(
        assets,
        winsor_p=cfg.winsor_p,
        env_w_intensity=cfg.env_w_intensity,
        env_w_abs=cfg.env_w_abs
    )

    report = format_report(result, features)
    print(report)

    if args.json_out:
        with open(args.json_out, "w", encoding="utf-8") as f:
            json.dump(result.to_json(), f, indent=2)
    return 0


def cli_run(args: argparse.Namespace) -> int:
    cfg = RunConfig(
        provider="csv" if args.csv else "mock",
        csv_path=args.csv,
        winsor_p=args.winsor_p,
        env_w_intensity=args.env_w_intensity,
        env_w_abs=args.env_w_abs,
        top_k=args.top_k,
        sector_lock=not args.no_sector_lock,
        region_lock=not args.no_region_lock,
        solver=args.solver,
        max_iters=args.max_iters,
        step_size=args.step_size,
        max_turnover=args.max_turnover,
        exposure_tolerance=args.exposure_tolerance,
        seed=args.seed,
        log=not args.quiet
    )

    assets = _load_assets_from_cfg(cfg)

    if args.portfolio:
        w = parse_portfolio_spec(args.portfolio)
        portfolio = Portfolio(w).normalized()
    else:
        # if user didn't supply portfolio, make one
        portfolio = make_demo_portfolio(assets, seed=args.seed, n_holdings=min(12, len(assets)))

    result = run_pipeline(cfg, portfolio, assets)

    # rebuild features to print report
    features = build_feature_table(
        assets,
        winsor_p=cfg.winsor_p,
        env_w_intensity=cfg.env_w_intensity,
        env_w_abs=cfg.env_w_abs
    )
    print(format_report(result, features))

    if args.json_out:
        with open(args.json_out, "w", encoding="utf-8") as f:
            json.dump(result.to_json(), f, indent=2)

    return 0


def build_arg_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(prog="macrobloom_monolith", description="Macrobloom-inspired swap optimizer (single-file monolith).")

    sub = p.add_subparsers(dest="cmd", required=True)

    def add_common(sp: argparse.ArgumentParser) -> None:
        sp.add_argument("--winsor-p", type=float, default=0.03)
        sp.add_argument("--env-w-intensity", type=float, default=1.0)
        sp.add_argument("--env-w-abs", type=float, default=0.15)
        sp.add_argument("--top-k", type=int, default=8)
        sp.add_argument("--no-sector-lock", action="store_true")
        sp.add_argument("--no-region-lock", action="store_true")
        sp.add_argument("--solver", choices=["qp_like", "greedy"], default="qp_like")
        sp.add_argument("--max-iters", type=int, default=1500)
        sp.add_argument("--step-size", type=float, default=0.05)
        sp.add_argument("--max-turnover", type=float, default=0.35)
        sp.add_argument("--exposure-tolerance", type=float, default=0.06)
        sp.add_argument("--seed", type=int, default=7)
        sp.add_argument("--json-out", type=str, default="")
        sp.add_argument("--quiet", action="store_true")

    demo = sub.add_parser("demo", help="Run a demo with a generated mock universe and random portfolio.")
    add_common(demo)
    demo.add_argument("--n", type=int, default=80, help="Size of mock universe.")
    demo.add_argument("--holdings", type=int, default=12, help="Number of holdings in demo portfolio.")
    demo.set_defaults(_fn=cli_demo)

    run = sub.add_parser("run", help="Run with CSV or mock provider; optional portfolio spec.")
    add_common(run)
    run.add_argument("--csv", type=str, default="", help="CSV path for asset universe.")
    run.add_argument("--portfolio", type=str, default="", help='Portfolio spec: "AAA:0.2,BBB:0.8"')
    run.set_defaults(_fn=cli_run)

    return p


def main(argv: Optional[List[str]] = None) -> int:
    argv = argv if argv is not None else sys.argv[1:]
    parser = build_arg_parser()
    args = parser.parse_args(argv)

    # Normalize json_out
    if getattr(args, "json_out", ""):
        # allow user to pass just a filename
        pass
    else:
        args.json_out = ""

    return int(args._fn(args))


